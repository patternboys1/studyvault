rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    function hasActivePremium() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null
        && profile.isPremium == true
        && profile.premiumExpiresAt is timestamp
        && profile.premiumExpiresAt > request.time;
    }

    // Read through authenticated Cloud Functions so free-plan answers can be
    // removed before the question data reaches the browser.
    match /BECE/{document=**} {
      allow read: if false;
      allow write: if false;
    }

    match /papers/{paperId} {
      allow read: if false;
      allow write: if false;
    }

    match /subjects/{subjectId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Users can read and write their own user document (for settings like darkMode)
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny([
          'plan', 'isPremium', 'billingCycle', 'premiumExpiresAt',
          'paymentVerifiedAt', 'lastPaymentReference'
        ]);
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'plan', 'isPremium', 'billingCycle', 'premiumExpiresAt',
            'paymentVerifiedAt', 'lastPaymentReference'
          ]);
    }

    match /users/{userId}/mockAttempts/{attemptId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /users/{userId}/{subcollection}/{documentId} {
      allow read, write: if false;
    }

    match /subjects/{subjectId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
